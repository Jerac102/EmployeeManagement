@page "/"
@rendermode InteractiveServer
@using EmployeeManagement.Shared.Models
@using EmployeeManagement.Shared.Services
@implements IAsyncDisposable
@inject IEmployeeEditor ViewModel
@inject IJSRuntime JS

<PageTitle>Employees</PageTitle>

<div class="page-head">
    <div>
        <h1>Employees</h1>
        <p class="subtitle">Edit rows inline, then press Save to apply all changes.</p>
    </div>
    <div class="stats">
        <span class="chip">@ViewModel.Rows.Count total</span>
        <span class="chip chip-changed @(ViewModel.ChangedRowCount > 0 ? "on" : "")">@ViewModel.ChangedRowCount changed</span>
        <span class="chip chip-deleted @(ViewModel.PendingDeleteCount > 0 ? "on" : "")">@ViewModel.PendingDeleteCount to delete</span>
    </div>
</div>

<div class="toolbar">
    <button class="btn" @onclick="AddRow" disabled="@_busy">+ Add</button>
    <button class="btn primary" @onclick="SaveAllAsync" disabled="@(_busy || !ViewModel.HasChanges)">Save changes</button>
    <button class="btn" @onclick="ReloadAsync" disabled="@_busy">Reload</button>
    @if (ViewModel.HasChanges)
    {
        <span class="dirty">&#9679; Unsaved changes</span>
    }
</div>

@if (_message is not null)
{
    <div class="alert @(_isError ? "error" : "ok")">@_message</div>
}

<div class="card">
    <div class="table-wrap">
        <table class="grid">
            <thead>
                <tr>
                    <th>First name</th>
                    <th>Last name</th>
                    <th>Email</th>
                    <th>Hire date</th>
                    <th>Salary</th>
                    <th>Department</th>
                    <th>Position</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in ViewModel.Rows)
                {
                    <tr class="@RowClass(row)">
                        <td><input @bind="row.FirstName" @bind:event="oninput" @bind:after="Changed" /></td>
                        <td><input @bind="row.LastName" @bind:event="oninput" @bind:after="Changed" /></td>
                        <td><input type="email" @bind="row.Email" @bind:event="oninput" @bind:after="Changed" /></td>
                        <td><input type="date" @bind="row.HireDate" @bind:after="Changed" /></td>
                        <td><input type="number" step="0.01" class="num" @bind="row.Salary" @bind:event="oninput" @bind:after="Changed" /></td>
                        <td>
                            <select @bind="row.DepartmentId" @bind:after="Changed">
                                @foreach (var d in ViewModel.Departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select @bind="row.PositionId" @bind:after="Changed">
                                @foreach (var p in ViewModel.Positions)
                                {
                                    <option value="@p.Id">@p.Name</option>
                                }
                            </select>
                        </td>
                        <td class="actions">
                            <button class="btn small @(row.IsMarkedForDelete ? "" : "danger")" @onclick="() => ToggleDelete(row)">
                                @(row.IsMarkedForDelete ? "Undo" : row.IsNew ? "Remove" : "Delete")
                            </button>
                        </td>
                    </tr>
                    @if (_errors.TryGetValue(row, out var err))
                    {
                        <tr class="error-row"><td colspan="8">@err</td></tr>
                    }
                }
                @if (ViewModel.Rows.Count == 0)
                {
                    <tr><td colspan="8" class="empty">No employees yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="legend">
    <span><i class="sw new"></i>New</span>
    <span><i class="sw modified"></i>Modified</span>
    <span><i class="sw deleted"></i>Pending delete</span>
</div>

@code {
    private readonly Dictionary<EmployeeRow, string> _errors = new();
    private IJSObjectReference? _module;
    private bool _busy;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/unsaved.js");
        await _module.InvokeVoidAsync("setDirty", ViewModel.HasChanges);
    }

    private async Task LoadAsync()
    {
        await ViewModel.LoadAsync();
        _errors.Clear();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        Show("Reloaded.", false);
    }

    private void Changed() => _message = null;

    private void AddRow()
    {
        ViewModel.Rows.Add(new EmployeeRow
        {
            DepartmentId = ViewModel.Departments.FirstOrDefault()?.Id ?? 0,
            PositionId = ViewModel.Positions.FirstOrDefault()?.Id ?? 0
        });
    }

    private void ToggleDelete(EmployeeRow row)
    {
        _errors.Remove(row);
        ViewModel.MarkForDelete(row);
    }

    private async Task SaveAllAsync()
    {
        _busy = true;
        _errors.Clear();
        _message = null;
        try
        {
            var deletes = await ViewModel.CommitDeletesAsync();
            if (!deletes.Success)
            {
                Show(deletes.Error ?? "Delete failed.", true);
                return;
            }

            var failed = 0;
            foreach (var row in ViewModel.Rows.Where(r => r.HasChanges).ToList())
            {
                var result = await ViewModel.SaveAsync(row);
                if (!result.Success)
                {
                    _errors[row] = result.Error ?? "Save failed.";
                    failed++;
                }
            }

            if (failed > 0)
            {
                Show($"{failed} row(s) could not be saved.", true);
            }
            else
            {
                Show("All changes saved.", false);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(string text, bool error)
    {
        _message = text;
        _isError = error;
    }

    private static string RowClass(EmployeeRow row) =>
        row.IsMarkedForDelete ? "deleted" : row.IsNew ? "new" : row.IsModified ? "modified" : "";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setDirty", false);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
